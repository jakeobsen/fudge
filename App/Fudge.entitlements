<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Fudge is signed with the hardened runtime (FUD-44), which denies a protected resource without its entitlement,
     whatever the user allows. Only what Fudge and the extensions it runs may use is here: Fudge starts their
     processes, so macOS counts their requests as Fudge's and asks the user first, with the texts in Info.plist (FUD-159).
     Bluetooth has no entitlement, only its text in Info.plist. Accessibility, Input Monitoring, Full Disk Access and
     Screen Recording are permissions the user grants in System Settings, with no entitlement. -->
<plist version="1.0">
<dict>
	<!-- Apple Events: Finder (the selection for extensions, counting and emptying the Trash), System Events
	     (Toggle Dark Mode), the login window (Restart, Shut Down and Log Out), and extensions' AppleScript. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Calendars: My Schedule reads the user's events through EventKit, and extensions read events and reminders. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<!-- Contacts: for extensions; Fudge itself doesn't read them. -->
	<key>com.apple.security.personal-information.addressbook</key>
	<true/>
	<!-- Location: for extensions; Fudge itself doesn't ask for it. -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- Photos: for extensions; Fudge itself doesn't read them. -->
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
	<!-- The camera: for extensions; Fudge itself doesn't use it. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- The microphone: for extensions, through their own programs or tools such as sox; Fudge itself doesn't use it. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
