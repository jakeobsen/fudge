{
  "name": "fudge-runtime",
  "private": true,
  "description": "The extension host: runs Raycast extensions for the fudge app.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "esbuild src/host.ts src/worker.ts --bundle --platform=node --format=esm --target=node22 --outdir=dist --define:process.env.NODE_ENV='\"production\"' --log-level=warning && esbuild scripts/compat/fudge-scan.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/compat-scan.js --external:esbuild --define:process.env.NODE_ENV='\"production\"' --log-level=warning",
    "generate": "node scripts/raycast-types.ts && node scripts/compat/raycast-utils.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p store-extension && tsc --noEmit -p file-search-extension && node scripts/raycast-types.ts --check && node scripts/compat/raycast-utils.ts --check",
    "test": "node --test 'test/**/*.test.ts'"
  },
  "devDependencies": {
    "@raycast/utils": "2.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-reconciler": "0.34.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-reconciler": "0.34.0"
  }
}
